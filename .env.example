# Academic Agent System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===== CORE APIs =====
# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (required)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Tavily Search API (optional - for web search functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith (optional - for debugging and monitoring)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false

# ===== MODEL CONTEXT PROTOCOL (MCP) =====
# Enable/disable MCP features
MCP_ENABLED=true
MCP_CONTEXT_TTL=3600
MCP_CLEANUP_INTERVAL=300

# ===== METRICS & MONITORING =====
# Enable/disable metrics collection
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL=60

# ===== PERFORMANCE SETTINGS =====
# Cache configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=./cache

# Schema cache settings
SCHEMA_CACHE_TTL=86400

# ===== SECURITY & ERROR HANDLING =====
# Error recovery settings
ERROR_RECOVERY_ENABLED=true
MAX_RECOVERY_ATTEMPTS=3

# ===== LLM CONFIGURATION =====
# Model settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# ===== SEARCH CONFIGURATION =====
# Tavily search settings
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# ===== LOGGING =====
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ===== DEVELOPMENT SETTINGS =====
# Set to true for development mode
DEBUG_MODE=false

# ===== STREAMLIT CONFIGURATION =====
# Streamlit specific settings (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
